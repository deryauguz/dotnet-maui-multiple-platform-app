<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GorselProgramlamaOdev2.Views.VKIHesaplamaSayfasi"
             Title="VKİ Hesaplama"
             Padding="20"
             BackgroundColor="#FFE6E8">
    <VerticalStackLayout Spacing="20">

        <Label Text="Kilonuzu Girin" FontSize="Medium" FontAttributes="Bold"/>
        <Label x:Name="LabelKilo" Text="Kilonuz (KG): 70.0" 
         FontSize="Small"/>

        <Slider x:Name="SliderKilo" 
                Minimum="30" 
                Maximum="150" 
                Value="70"
                ValueChanged="HesaplaVKI_ValueChanged"/>

        <Entry x:Name="EntryKilo"
               Placeholder="Kilo (KG)"
               Keyboard="Numeric"
               Text="70"
               TextChanged="EntryKilo_TextChanged"/>


        <Label Text="Boyunuzu Girin" FontSize="Medium" FontAttributes="Bold"/>
        <Label x:Name="LabelBoy" Text="Boyunuz (CM): 170" FontSize="Small"/>

        <Slider x:Name="SliderBoy" 
                Minimum="100" 
                Maximum="220" 
                Value="170" 
                ValueChanged="HesaplaVKI_ValueChanged"/>

        <Entry x:Name="EntryBoy"
               Placeholder="Boy (CM)"
               Keyboard="Numeric"
               Text="170"
               TextChanged="EntryBoy_TextChanged"/>


        <BoxView HeightRequest="1" Color="LightGray" Margin="0,10,0,10"/>

        <Label Text="VKİ SONUCU" 
         FontSize="Large" FontAttributes="Bold" HorizontalOptions="Center"/>

        <Label x:Name="LabelVKIDeger" Text="VKİ Değeri: 0.00" FontSize="Medium" FontAttributes="Bold" HorizontalOptions="Center"/>
        <Label x:Name="LabelVKIKategori" Text="Kategori: Bilgi Yok" FontSize="Medium" HorizontalOptions="Center"/>

    </VerticalStackLayout>
</ContentPage>