<?xml version="1.0" encoding="UTF-8"?>
<Shell
    x:Class="GorselProgramlamaOdev2.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:GorselProgramlamaOdev2.Views"
    
    
    Shell.BackgroundColor="#4B0082" 
    Shell.FlyoutBackgroundColor="{StaticResource PageBackgroundColor}"
    Shell.TitleColor="White" 
    Shell.ForegroundColor="White">

    <Shell.FlyoutBehavior>Flyout</Shell.FlyoutBehavior>

    <ShellContent
        Title="Ana Sayfa"
        Icon="home_icon.png" 
        ContentTemplate="{DataTemplate local:MainPage}" 
        Route="AnaSayfa" />

    <FlyoutItem Title="Kredi Hesaplama" Icon="kredi_icon.png">
        <ShellContent
            ContentTemplate="{DataTemplate local:KrediHesaplamaSayfasi}"
            Route="KrediSayfasi" />
    </FlyoutItem>

    <FlyoutItem Title="Vücut Kitle İndeksi" Icon="vki_icon.png">
        <ShellContent
            ContentTemplate="{DataTemplate local:VKIHesaplamaSayfasi}"
            Route="VkiSayfasi" />
    </FlyoutItem>

    <FlyoutItem Title="Renk Seçici" Icon="renk_icon.png">
        <ShellContent
            ContentTemplate="{DataTemplate local:RenkSeciciSayfasi}"
            Route="RenkSayfasi" />
    </FlyoutItem>

</Shell>
