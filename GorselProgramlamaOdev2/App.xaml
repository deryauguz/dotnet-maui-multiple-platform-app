<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GorselProgramlamaOdev2.App">
    <Application.Resources>
        <ResourceDictionary>

            <Color x:Key="PastelPink">#FFC0CB</Color>
            <Color x:Key="SoftLavender">#E6E6FA</Color>
            <Color x:Key="DarkAccent">#4B0082</Color>
            <Color x:Key="PageBackgroundColor">#FFF0F5</Color>

            <Color x:Key="Primary">#FFC0CB</Color>
            <Color x:Key="Black">#4B0082</Color>
            <Color x:Key="White">#FFF0F5</Color>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>